{
  "name": "site-kit-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "build": "npm run build -w demo",
    "preview": "npm run preview -w demo",
    "check": "npm run check:tokens && npm run check -w demo",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:build": "vitest run --project build"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
