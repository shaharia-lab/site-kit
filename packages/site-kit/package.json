{
  "name": "@shaharia-lab/site-kit",
  "version": "0.1.0",
  "description": "A themeable Starlight layer for Shaharia Lab open-source project sites: themes, page actions, Markdown twins, llms.txt and Edit on GitHub.",
  "license": "MIT",
  "author": "Shaharia Lab (https://shaharialab.com)",
  "homepage": "https://github.com/shaharia-lab/site-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaharia-lab/site-kit.git",
    "directory": "packages/site-kit"
  },
  "bugs": {
    "url": "https://github.com/shaharia-lab/site-kit/issues"
  },
  "keywords": [
    "astro",
    "starlight",
    "starlight-plugin",
    "withastro",
    "documentation",
    "theme"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./middleware": "./middleware.ts",
    "./overrides/*": "./overrides/*",
    "./styles/*": "./styles/*",
    "./themes/agento-code": "./themes/agento-code/index.ts",
    "./themes/agento-code/*": "./themes/agento-code/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "middleware.ts",
    "edit-link.ts",
    "theme.ts",
    "virtual.d.ts",
    "overrides",
    "styles",
    "themes",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@shaharia-lab/agento-code": "0.3.1",
    "starlight-llms-txt": "^0.12.0",
    "starlight-page-actions": "^0.7.1"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.10",
    "astro": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
